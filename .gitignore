# Рантайм-кэш Sinytra Connector — генерируется у каждого игрока сам
wanderlust-create/mods/.connector/

# Логи и бэкапы конфигов — в пак не входят
*.log
*.bak
*.tmp

# Крупные jar раздаются через GitHub Releases, а не из репозитория
/releases-upload/

# Появляется, когда mods.py подгружает сборщик ради его списка исключений.
__pycache__/
